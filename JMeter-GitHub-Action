name: JMeter_run

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  run-jmeter:
    runs-on: ubuntu-latest

    env:
      JMETER_HOME: ${{ github.workspace }}/apache-jmeter-5.6.3

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Install Java & dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y openjdk-17-jdk unzip

      - name: Download and Setup JMeter
        run: |
          curl -sL https://downloads.apache.org/jmeter/binaries/apache-jmeter-5.6.3.zip -o jmeter.zip
          unzip -o -q jmeter.zip
          chmod +x apache-jmeter-5.6.3/bin/jmeter

      - name: Set timestamp variable
        id: set-time
        run: echo "timestamp=$(date +'%Y-%m-%d_%H-%M-%S')" >> "$GITHUB_OUTPUT"

      - name: Run JMeter Test Plan
        run: |
          export PATH="$JMETER_HOME/bin:$PATH"
          mkdir -p Results/${{ steps.set-time.outputs.timestamp }}
          jmeter -n \
            -t $JMETER_HOME/bin/examples/CSVSample.jmx \
            -l Results/${{ steps.set-time.outputs.timestamp }}/results.jtl \
            -Jjmeter.save.saveservice.output_format=csv \
            -Jjmeter.save.saveservice.timestamp_format=ms \
            -Jjmeter.save.saveservice.default_delimiter=, \
            -Jjmeter.save.saveservice.assertion_results=none \
            -Jjmeter.save.saveservice.bytes=true \
            -Jjmeter.save.saveservice.label=true \
            -Jjmeter.save.saveservice.latency=true \
            -Jjmeter.save.saveservice.response_code=true \
            -Jjmeter.save.saveservice.response_message=true \
            -Jjmeter.save.saveservice.successful=true \
            -Jjmeter.save.saveservice.thread_name=true \
            -Jjmeter.save.saveservice.time=true \
            -Jjmeter.save.saveservice.connect_time=true

      - name: Generate HTML Report
        run: |
          export PATH="$JMETER_HOME/bin:$PATH"
          jmeter -g Results/${{ steps.set-time.outputs.timestamp }}/results.jtl \
            -o Results/${{ steps.set-time.outputs.timestamp }}/html-report || echo "⚠️ HTML report generation failed."

      - name: Upload JMeter Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: jmeter-artifacts-${{ steps.set-time.outputs.timestamp }}
          path: Results/${{ steps.set-time.outputs.timestamp }}
